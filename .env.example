# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Resend (T2 — forgot-password email)
# Test-only sender is hardcoded to onboarding@resend.dev in src/lib/server/email.ts
# (can only deliver to the email your Resend account was registered with, until
# a real sending domain is verified — see T5).
RESEND_API_KEY=""
